# Never commit real values.
# Local: copy this file to backend/.env (git-ignored) and fill the keys. scripts/dev-backend.ps1,
#   scripts/prepare-data.ps1 and scripts/sync-tourism.ps1 load it into their own process only;
#   variables already set in the environment win. Values are never printed.
# Server: the app does not read this file; export the variables in the process environment
#   (systemd EnvironmentFile etc.).

# data.go.kr 행정안전부_대한민국 공공서비스(혜택) 정보 — Decoding key
KIROTHON_DATA_GO_KR_SERVICE_KEY=

# Optional tuning (defaults shown in backend/app/team/benefits/gov24.py)
KIROTHON_GOV24_CACHE_TTL_SECONDS=
KIROTHON_GOV24_MAX_PAGES=
KIROTHON_GOV24_DAILY_CALL_LIMIT=

# 관광공사 API(KorService2·중심 관광지·연관 관광지) 수집과 장소 상세 조회용 Decoding 키.
# 비우면 KIROTHON_DATA_GO_KR_SERVICE_KEY를 쓴다(같은 공공데이터포털 계정 키, API별 활용신청 필요).
TOURAPI_SERVICE_KEY=
# MobileApp 요청값(서비스명). 비우면 RefundFirstCourse.
TOURAPI_MOBILE_APP=
# 시연용 기준일 고정(YYYY-MM-DD). 비우면 한국시간 오늘. /api/team과 지원제도 연결 판정에 같이 쓴다.
TEAM_TODAY=
